# AWS Configuration
# Get STATE_MACHINE_ARN from CloudFormation output:
# aws cloudformation describe-stacks --stack-name EvaluationPipelineOrchestration \
#   --query 'Stacks[0].Outputs[?OutputKey==`StateMachineArn`].OutputValue' --output text

STATE_MACHINE_ARN=arn:aws:states:us-west-2:ACCOUNT_ID:stateMachine:evaluation-pipeline
AWS_REGION=us-west-2

# Optional: AWS Profile for local development
# AWS_PROFILE=binbash
