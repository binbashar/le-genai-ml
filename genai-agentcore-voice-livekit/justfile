# AgentCore Voice Agent - Task Runner
# Usage: just <recipe> [args]
# Run `just --list` to see all available recipes

# Default AWS profile (override with: just --set profile myprofile <recipe>)
profile := env_var_or_default("AWS_PROFILE", "default")

# Default room name
room := "voice-room"

# Voice ID (default: tiffany)
voice := env_var_or_default("VOICE_ID", "tiffany")

# LiveKit dev credentials (default values from `livekit-server --dev`, not real secrets)
lk_api_key := "devkey"
lk_api_secret := "secret"

# Show available recipes
default:
    @just --list

# === Setup ===

# Install LiveKit server and CLI (macOS/Linux via Homebrew)
install-livekit:
    brew install livekit livekit-cli

# Install Python dependencies for bridge worker and agentcore voice agent
install:
    uv sync
    cd agentcore && uv sync

# Check if all prerequisites are installed
check:
    #!/usr/bin/env bash
    set -e
    echo "Checking prerequisites..."

    check_cmd() {
        if command -v $1 &>/dev/null; then
            echo "  ok  $1"
        else
            echo "  MISSING  $1"
            return 1
        fi
    }

    check_cmd aws
    check_cmd livekit-server
    check_cmd lk
    check_cmd uv
    check_cmd python3
    check_cmd just

    echo ""
    echo "All checks passed!"

# === AWS SSO ===

# Login to AWS SSO
sso-login:
    aws sso login --profile {{profile}}

# Export AWS credentials to current shell (prints export commands)
sso-export:
    @echo "Run this command to export credentials:"
    @echo ""
    @echo 'eval $(just _sso-env)'

# Internal: generate export commands
_sso-env:
    #!/usr/bin/env bash
    set -euo pipefail
    if aws configure export-credentials --profile {{profile}} --format env 2>/dev/null; then
        exit 0
    fi
    echo "export AWS_ACCESS_KEY_ID=$(aws configure get aws_access_key_id --profile {{profile}})"
    echo "export AWS_SECRET_ACCESS_KEY=$(aws configure get aws_secret_access_key --profile {{profile}})"
    TOKEN=$(aws configure get aws_session_token --profile {{profile}} 2>/dev/null || echo "")
    if [ -n "$TOKEN" ]; then
        echo "export AWS_SESSION_TOKEN=$TOKEN"
    fi
    echo "export AWS_DEFAULT_REGION=$(aws configure get region --profile {{profile}} || echo 'us-east-1')"

# Check AWS identity
whoami:
    aws sts get-caller-identity --profile {{profile}}

# === Level 1: All Local ===

# Start the AgentCore voice agent locally (WebSocket on port 8080)
voice-agent:
    cd agentcore && uv run python voice_agent.py

# Run the bridge worker connecting to local voice agent
bridge:
    #!/usr/bin/env bash
    set -euo pipefail
    export AGENTCORE_WS_URL=ws://localhost:8080/ws
    export VOICE_BACKEND=nova_sonic
    export VOICE_ID={{voice}}
    export LIVEKIT_URL=ws://localhost:7880
    export LIVEKIT_API_KEY={{lk_api_key}}
    export LIVEKIT_API_SECRET={{lk_api_secret}}
    echo "Bridge -> AgentCore: $AGENTCORE_WS_URL"
    echo "Bridge -> LiveKit:   $LIVEKIT_URL"
    echo "Voice: $VOICE_ID"
    uv run python agent.py dev

# Start LiveKit server in dev mode
livekit-server:
    livekit-server --dev

# Serve frontend on port 3000
frontend:
    cd web && python -m http.server 3000

# Generate LiveKit token for the frontend
token identity="user1":
    lk token create \
        --api-key {{lk_api_key}} --api-secret {{lk_api_secret}} \
        --join --room {{room}} --identity {{identity}} \
        --valid-for 24h

# Start everything with one command (Level 1: all local)
start:
    #!/usr/bin/env bash
    set -euo pipefail

    echo "Starting AgentCore Voice Agent (all local)..."
    echo ""

    # 1. Verify prerequisites
    just check || { echo "Missing prerequisites. Run 'just install-livekit' first."; exit 1; }

    # 2. Check if LiveKit server is already running
    if ! pgrep -x "livekit-server" > /dev/null; then
        echo "Starting LiveKit server..."
        livekit-server --dev > /tmp/livekit-server.log 2>&1 &
        sleep 2
    else
        echo "LiveKit server already running"
    fi

    # 3. Setup AWS credentials (needed by voice agent for Bedrock)
    echo "Setting up AWS credentials (profile: {{profile}})..."
    if ! aws sts get-caller-identity --profile {{profile}} &>/dev/null; then
        aws sso login --profile {{profile}}
    fi

    eval $(aws configure export-credentials --profile {{profile}} --format env 2>/dev/null || \
        echo "export AWS_ACCESS_KEY_ID=$(aws configure get aws_access_key_id --profile {{profile}}); \
              export AWS_SECRET_ACCESS_KEY=$(aws configure get aws_secret_access_key --profile {{profile}}); \
              export AWS_SESSION_TOKEN=$(aws configure get aws_session_token --profile {{profile}} 2>/dev/null || echo '')")

    export AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION:-$(aws configure get region --profile {{profile}} 2>/dev/null || echo 'us-east-1')}

    # 4. Start voice agent in background
    echo "Starting voice agent..."
    (cd agentcore && uv run python voice_agent.py) > /tmp/voice-agent.log 2>&1 &
    VOICE_PID=$!
    sleep 3

    if ! kill -0 $VOICE_PID 2>/dev/null; then
        echo "Voice agent failed to start. Check /tmp/voice-agent.log"
        cat /tmp/voice-agent.log
        exit 1
    fi

    # 5. Start bridge worker in background
    echo "Starting bridge worker..."
    export AGENTCORE_WS_URL=ws://localhost:8080/ws
    export VOICE_BACKEND=nova_sonic
    export VOICE_ID={{voice}}
    export LIVEKIT_URL=ws://localhost:7880
    export LIVEKIT_API_KEY={{lk_api_key}}
    export LIVEKIT_API_SECRET={{lk_api_secret}}

    uv run python agent.py dev > /tmp/bridge-worker.log 2>&1 &
    BRIDGE_PID=$!
    sleep 2

    if ! kill -0 $BRIDGE_PID 2>/dev/null; then
        echo "Bridge worker failed to start. Check /tmp/bridge-worker.log"
        cat /tmp/bridge-worker.log
        exit 1
    fi

    # 6. Generate token
    echo "Generating token..."
    TOKEN=$(lk token create --api-key {{lk_api_key}} --api-secret {{lk_api_secret}} \
        --join --room {{room}} --identity user1 --valid-for 24h | grep "Access token:" | cut -d' ' -f3)

    # 7. Open browser and serve frontend
    echo ""
    echo "AgentCore Voice Agent is running!"
    echo "  LiveKit server:  ws://localhost:7880"
    echo "  Voice agent:     ws://localhost:8080/ws"
    echo "  Bridge worker:   connected"
    echo "  Frontend:        http://localhost:3000"
    echo ""
    echo "  Logs: /tmp/livekit-server.log"
    echo "        /tmp/voice-agent.log"
    echo "        /tmp/bridge-worker.log"
    echo ""
    echo "  Press Ctrl+C to stop, or run: just stop"
    echo ""

    (sleep 2 && open "http://localhost:3000?token=$TOKEN") &

    # Serve frontend in foreground (Ctrl+C to stop)
    cd web && python -m http.server 3000

# Stop all processes
stop:
    #!/usr/bin/env bash
    echo "Stopping AgentCore Voice Agent..."
    pkill -f "livekit-server" 2>/dev/null || true
    pkill -f "voice_agent.py" 2>/dev/null || true
    pkill -f "agent.py" 2>/dev/null || true
    pkill -f "http.server 3000" 2>/dev/null || true
    echo "All processes stopped"

# === Level 2: Hybrid (local LiveKit + AWS AgentCore) ===

# Deploy voice agent to AWS AgentCore
deploy-agentcore:
    cd agentcore && uv run agentcore configure -e voice_agent.py && uv run agentcore launch

# Start hybrid mode (local LiveKit + bridge, AWS AgentCore Runtime)
start-hybrid arn:
    #!/usr/bin/env bash
    set -euo pipefail

    echo "Starting AgentCore Voice Agent (hybrid mode)..."
    echo "  AgentCore ARN: {{arn}}"
    echo ""

    # 1. Verify prerequisites
    just check || { echo "Missing prerequisites."; exit 1; }

    # 2. Start LiveKit server if not running
    if ! pgrep -x "livekit-server" > /dev/null; then
        echo "Starting LiveKit server..."
        livekit-server --dev > /tmp/livekit-server.log 2>&1 &
        sleep 2
    else
        echo "LiveKit server already running"
    fi

    # 3. Setup AWS credentials
    echo "Setting up AWS credentials (profile: {{profile}})..."
    if ! aws sts get-caller-identity --profile {{profile}} &>/dev/null; then
        aws sso login --profile {{profile}}
    fi

    eval $(aws configure export-credentials --profile {{profile}} --format env 2>/dev/null || \
        echo "export AWS_ACCESS_KEY_ID=$(aws configure get aws_access_key_id --profile {{profile}}); \
              export AWS_SECRET_ACCESS_KEY=$(aws configure get aws_secret_access_key --profile {{profile}}); \
              export AWS_SESSION_TOKEN=$(aws configure get aws_session_token --profile {{profile}} 2>/dev/null || echo '')")

    export AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION:-$(aws configure get region --profile {{profile}} 2>/dev/null || echo 'us-east-1')}

    # 4. Start bridge worker with ARN (no local voice agent needed)
    echo "Starting bridge worker (ARN mode)..."
    export AGENTCORE_RUNTIME_ARN={{arn}}
    export VOICE_BACKEND=nova_sonic
    export VOICE_ID={{voice}}
    export LIVEKIT_URL=ws://localhost:7880
    export LIVEKIT_API_KEY={{lk_api_key}}
    export LIVEKIT_API_SECRET={{lk_api_secret}}

    uv run python agent.py dev > /tmp/bridge-worker.log 2>&1 &
    BRIDGE_PID=$!
    sleep 2

    if ! kill -0 $BRIDGE_PID 2>/dev/null; then
        echo "Bridge worker failed to start. Check /tmp/bridge-worker.log"
        cat /tmp/bridge-worker.log
        exit 1
    fi

    # 5. Generate token and open browser
    echo "Generating token..."
    TOKEN=$(lk token create --api-key {{lk_api_key}} --api-secret {{lk_api_secret}} \
        --join --room {{room}} --identity user1 --valid-for 24h | grep "Access token:" | cut -d' ' -f3)

    echo ""
    echo "AgentCore Voice Agent is running (hybrid)!"
    echo "  LiveKit server:   ws://localhost:7880"
    echo "  AgentCore (AWS):  {{arn}}"
    echo "  Bridge worker:    connected"
    echo "  Frontend:         http://localhost:3000"
    echo ""
    echo "  Press Ctrl+C to stop, or run: just stop"
    echo ""

    (sleep 2 && open "http://localhost:3000?token=$TOKEN") &

    # Serve frontend in foreground
    cd web && python -m http.server 3000

# === Utilities ===

# Clean up generated files and virtual environments
clean:
    rm -rf .venv agentcore/.venv __pycache__ agentcore/__pycache__
